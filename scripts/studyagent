#!/usr/bin/env bash
set -e

SERVICES="studyagent-ollama.service studyagent-api.service studyagent-web.service"

case "${1:-start}" in
  start)
    systemctl --user start $SERVICES
    for i in $(seq 1 30); do
      if curl -s --max-time 1 http://localhost:5173 > /dev/null 2>&1 &&
         curl -s --max-time 1 http://localhost:8000/api/health | grep -q ok; then
        break
      fi
      sleep 1
    done
    echo "StudyAgent: http://localhost:5173"
    ;;
  stop)
    systemctl --user stop studyagent-web.service studyagent-api.service
    echo "StudyAgent encerrado (Ollama continua ativo)."
    ;;
  status)
    systemctl --user is-active --quiet studyagent-ollama.service \
      && echo "ollama    ✓" || echo "ollama    ✗"
    curl -s --max-time 2 http://localhost:8000/api/health 2>/dev/null | grep -q ok \
      && echo "api       ✓" || echo "api       ✗"
    curl -s --max-time 2 http://localhost:5173 > /dev/null 2>&1 \
      && echo "frontend  ✓" || echo "frontend  ✗"
    ;;
  restart)
    systemctl --user restart studyagent-web.service studyagent-api.service
    "$0" status
    ;;
  logs)
    journalctl --user -u studyagent-api.service -u studyagent-web.service -f --no-pager
    ;;
  *)
    echo "uso: studyagent [start|stop|status|restart|logs]"
    ;;
esac
