[Unit]
Description=StudyAgent API
After=studyagent-ollama.service
Wants=studyagent-ollama.service

[Service]
WorkingDirectory=%h/StudyAgent/backend
Environment=DISPLAY=:1
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=%h/StudyAgent/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target