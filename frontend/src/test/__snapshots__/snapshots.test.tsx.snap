exports[`ChatMessages snapshots > renders error state 1`] = `
<div>
  <div
    class="chat-messages"
  >
    <div
      class="chat-welcome"
    >
      <h2>
        Olá! 👋
      </h2>
      <p>
        Como posso ajudar nos seus estudos?
      </p>
      <p
        class="hint"
      >
        🔄 modo conversa · 🖥 tela · 🎙 aperte para falar
      </p>
    </div>
    <div
      class="msg-error"
    >
      ⚠ 
      Erro teste
    </div>
  </div>
</div>
`;

