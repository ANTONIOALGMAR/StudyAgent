// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ChatInput snapshots > renders default state 1`] = `
<div>
  <div
    class="chat-input"
  >
    <input
      accept=".pdf,.txt,.md"
      style="display: none;"
      type="file"
    />
    <button
      class="btn-mic "
      title="Falar com o agente (aperte para falar)"
    >
      🎙
    </button>
    <input
      placeholder="Fale com o StudyAgent…"
      value=""
    />
    <button
      class="btn-screen active"
      title="Responder por voz"
    >
      🔊
    </button>
    <button
      class="btn-send "
      title="Modo conversa automática"
    >
      🔄
    </button>
  </div>
</div>
`;

exports[`ChatInput snapshots > renders hands-free state 1`] = `
<div>
  <div
    class="chat-input"
  >
    <input
      accept=".pdf,.txt,.md"
      style="display: none;"
      type="file"
    />
    <button
      class="btn-mic "
      disabled=""
      title="Falar com o agente (aperte para falar)"
    >
      🎙
    </button>
    <input
      placeholder="modo conversa ativo — pode falar!"
      value=""
    />
    <button
      class="btn-screen active"
      title="Responder por voz"
    >
      🔊
    </button>
    <button
      class="btn-send hf-on"
      title="Desligar modo conversa"
    >
      ⏹
    </button>
  </div>
</div>
`;

