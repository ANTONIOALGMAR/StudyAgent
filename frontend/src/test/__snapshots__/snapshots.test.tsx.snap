exports[`LivePanel snapshots > renders default state 1`] = `
<div>
  <div
    class="live-panel"
  >
    <div
      class="live-head"
    >
      <span
        class="live-dot"
      />
      <strong>
        ao vivo
      </strong>
      <select>
        <option
          value="0"
        >
          Todas as telas
        </option>
      </select>
      <button
        class="btn-screen"
        title="Minimizar"
      >
        —
      </button>
      <button
        class="btn-screen"
      >
        ✕
      </button>
    </div>
    <img
      alt="tela ao vivo"
      class="live-img"
      src="http://localhost:8000/api/screen/preview?monitor=0"
    />
    <label
      class="watch-toggle"
    >
      <input
        type="checkbox"
      />
      agente comenta mudanças automaticamente
    </label>
  </div>
</div>
`;

exports[`LivePanel snapshots > renders with watch mode enabled 1`] = `
<div>
  <div
    class="live-panel"
  >
    <div
      class="live-head"
    >
      <span
        class="live-dot"
      />
      <strong>
        ao vivo
      </strong>
      <select>
        <option
          value="0"
        >
          Todas as telas
        </option>
      </select>
      <button
        class="btn-screen"
        title="Minimizar"
      >
        —
      </button>
      <button
        class="btn-screen"
      >
        ✕
      </button>
    </div>
    <img
      alt="tela ao vivo"
      class="live-img"
      src="http://localhost:8000/api/screen/preview?monitor=0"
    />
    <label
      class="watch-toggle"
    >
      <input
        checked=""
        type="checkbox"
      />
      agente comenta mudanças automaticamente
    </label>
  </div>
</div>
`;
