# StudyAgent Environment Variables

# ── LLM Models ────────────────────────────────────────────────────
# Ollama model for chat/reasoning
STUDYAGENT_LLM_MODEL=llama3.1:latest

# Ollama model for vision (image analysis)
STUDYAGENT_VISION_MODEL=qwen2.5vl:7b

# Ollama model for embeddings (RAG)
STUDYAGENT_EMBED_MODEL=nomic-embed-text

# ── Paths ──────────────────────────────────────────────────────────
# Base data directory
STUDYAGENT_DATA_DIR=./data

# ── Server ─────────────────────────────────────────────────────────
# Host to bind (local only por padrão — evita exposição na rede)
STUDYAGENT_HOST=127.0.0.1

# Port
STUDYAGENT_PORT=8000

# ── Segurança ──────────────────────────────────────────────────────
# PIN local exigido para ativar permissões perigosas
# (mouse_control, keyboard_control, command_execution).
# Em branco = bloqueado (fail-closed, exige configuração explícita).
# Defina um valor e envie-o no header X-StudyAgent-Pin para liberar.
STUDYAGENT_PIN=

# ── Features ───────────────────────────────────────────────────────
# Enable web search (requires internet permission)
STUDYAGENT_WEB_SEARCH=true

# Enable screen capture
STUDYAGENT_SCREEN_CAPTURE=true
